<?xml version="1.0" encoding="utf-8"?>
<!-- Linha do caderno: Série · Carga · Reps · ✓, com pauta rule de 1dp embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_session_set"
    android:minHeight="@dimen/touch_min"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_1"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_1">

        <TextView
            android:id="@+id/number"
            android:layout_width="@dimen/space_6"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textAppearance="@style/TextAppearance.MuscleNotes.Load"
            tools:text="1" />

        <ImageButton
            android:id="@+id/weight_minus"
            android:layout_width="40dp"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/session_weight_minus"
            android:src="@drawable/ic_remove" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/weight_layout"
            style="@style/Widget.MuscleNotes.TextInputLayout.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/session_weight"
            app:expandedHintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789.,"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:maxLength="7"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.MuscleNotes.Load" />

        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/weight_plus"
            android:layout_width="40dp"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/session_weight_plus"
            android:src="@drawable/ic_add" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/reps_layout"
            style="@style/Widget.MuscleNotes.TextInputLayout.Dense"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:hint="@string/session_reps"
            app:expandedHintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/reps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="3"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.MuscleNotes.Load" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/done"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_1" />

        <ImageButton
            android:id="@+id/remove"
            android:layout_width="40dp"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <TextView
        android:id="@+id/record"
        style="@style/Widget.MuscleNotes.RecordBadge"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="@dimen/space_2"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        tools:text="PR de carga"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.MuscleNotes.Caption"
        android:textColor="@color/perigo"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rule" />

</LinearLayout>
