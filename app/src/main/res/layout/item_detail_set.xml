<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:minHeight="36dp"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_1"
    android:paddingEnd="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/number"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.MuscleNotes.Label"
            android:textColor="@color/ink_muted"
            tools:text="Série 1" />

        <TextView
            android:id="@+id/values"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.MuscleNotes.Load"
            tools:text="62,5 kg × 10" />

    </LinearLayout>

    <!-- Abaixo dos valores: o texto do recorde é longo e espremeria a carga numa linha só. -->
    <TextView
        android:id="@+id/record"
        style="@style/Widget.MuscleNotes.RecordBadge"
        android:layout_marginStart="72dp"
        android:layout_marginTop="@dimen/space_1"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:text="Novo recorde de carga"
        tools:visibility="visible" />

</LinearLayout>
