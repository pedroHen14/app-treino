<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/todayFragment">

    <!-- Abre a sessão em andamento de qualquer lugar (tela Hoje, escolha de treino, retomada ao abrir o app). -->
    <action
        android:id="@+id/action_global_session"
        app:destination="@id/sessionFragment"
        app:launchSingleTop="true" />

    <action
        android:id="@+id/action_global_startWorkout"
        app:destination="@id/startWorkoutBottomSheet" />

    <fragment
        android:id="@+id/todayFragment"
        android:name="com.pedro.treinoapp.feature.today.presentation.TodayFragment"
        android:label="@string/nav_today"
        tools:layout="@layout/fragment_today" />

    <fragment
        android:id="@+id/workoutFragment"
        android:name="com.pedro.treinoapp.feature.workout.presentation.WorkoutFragment"
        android:label="@string/nav_workouts"
        tools:layout="@layout/fragment_workout">

        <action
            android:id="@+id/action_workout_to_exerciseCatalog"
            app:destination="@id/exerciseCatalogFragment" />

        <action
            android:id="@+id/action_workout_to_templateEditor"
            app:destination="@id/templateEditorFragment" />

    </fragment>

    <fragment
        android:id="@+id/templateEditorFragment"
        android:name="com.pedro.treinoapp.feature.workout.presentation.editor.TemplateEditorFragment"
        tools:layout="@layout/fragment_template_editor">

        <argument
            android:name="templateId"
            android:defaultValue="-1L"
            app:argType="long" />

        <action
            android:id="@+id/action_templateEditor_to_exerciseCatalog"
            app:destination="@id/exerciseCatalogFragment" />

    </fragment>

    <fragment
        android:id="@+id/exerciseCatalogFragment"
        android:name="com.pedro.treinoapp.feature.exercise.presentation.catalog.ExerciseCatalogFragment"
        android:label="@string/exercise_catalog_title"
        tools:layout="@layout/fragment_exercise_catalog">

        <argument
            android:name="selectionMode"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="singleSelection"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="excludedIds"
            android:defaultValue="@null"
            app:argType="long[]"
            app:nullable="true" />

        <action
            android:id="@+id/action_exerciseCatalog_to_exerciseForm"
            app:destination="@id/exerciseFormBottomSheet" />

        <action
            android:id="@+id/action_exerciseCatalog_to_wgerSearch"
            app:destination="@id/wgerSearchFragment" />

    </fragment>

    <dialog
        android:id="@+id/exerciseFormBottomSheet"
        android:name="com.pedro.treinoapp.feature.exercise.presentation.form.ExerciseFormBottomSheet"
        tools:layout="@layout/bottom_sheet_exercise_form">

        <argument
            android:name="exerciseId"
            android:defaultValue="-1L"
            app:argType="long" />

    </dialog>

    <fragment
        android:id="@+id/wgerSearchFragment"
        android:name="com.pedro.treinoapp.feature.exercise.presentation.wger.WgerSearchFragment"
        android:label="@string/wger_search_title"
        tools:layout="@layout/fragment_wger_search" />

    <fragment
        android:id="@+id/sessionFragment"
        android:name="com.pedro.treinoapp.feature.session.presentation.SessionFragment"
        tools:layout="@layout/fragment_session">

        <argument
            android:name="sessionId"
            app:argType="long" />

        <action
            android:id="@+id/action_session_to_exerciseCatalog"
            app:destination="@id/exerciseCatalogFragment" />

        <action
            android:id="@+id/action_session_to_exerciseProgress"
            app:destination="@id/exerciseProgressFragment" />

    </fragment>

    <dialog
        android:id="@+id/startWorkoutBottomSheet"
        android:name="com.pedro.treinoapp.feature.session.presentation.start.StartWorkoutBottomSheet"
        tools:layout="@layout/bottom_sheet_start_workout" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.pedro.treinoapp.feature.history.presentation.HistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_history">

        <action
            android:id="@+id/action_history_to_sessionDetail"
            app:destination="@id/sessionDetailFragment" />

        <action
            android:id="@+id/action_history_to_exerciseProgress"
            app:destination="@id/exerciseProgressFragment" />

    </fragment>

    <fragment
        android:id="@+id/sessionDetailFragment"
        android:name="com.pedro.treinoapp.feature.history.presentation.detail.SessionDetailFragment"
        tools:layout="@layout/fragment_session_detail">

        <argument
            android:name="sessionId"
            app:argType="long" />

        <action
            android:id="@+id/action_sessionDetail_to_exerciseProgress"
            app:destination="@id/exerciseProgressFragment" />

    </fragment>

    <fragment
        android:id="@+id/exerciseProgressFragment"
        android:name="com.pedro.treinoapp.feature.history.presentation.progress.ExerciseProgressFragment"
        tools:layout="@layout/fragment_exercise_progress">

        <argument
            android:name="exerciseId"
            app:argType="long" />

    </fragment>

</navigation>
